# Optional environment for the local Headroom proxy. Nothing here is required
# for `headroom wrap claude`; defaults are loopback-only and fully offline.

# Keep every optional network fetch off (HF model downloads, license/beacon
# code paths — the latter are removed from this fork, this is belt-and-braces).
HEADROOM_OFFLINE=1

# Do not auto-fetch difft/scc binaries from GitHub at proxy startup.
# Run `headroom tools install` explicitly if you want them.
HEADROOM_BINARIES_OFFLINE=1

# litellm (used only for local price tables) must not fetch its cost map.
LITELLM_LOCAL_MODEL_COST_MAP=True

# Proxy token — only needed if you ever bind to something other than loopback.
# Generate: openssl rand -hex 32
# HEADROOM_PROXY_TOKEN=
# HEADROOM_BIND_ADDR=127.0.0.1
